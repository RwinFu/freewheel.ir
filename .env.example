# نمونه‌ی متغیرهای محیطی — این فایل را به .env.local کپی کنید.

# ── دیتابیس (اختیاری) ─────────────────────────────────────────────
#   • بدون DATABASE_URL، همه‌ی صفحه‌ها و جست‌وجوی کاتالوگ کار می‌کنند
#     (جست‌وجو روی محتوای ایستای سایت انجام می‌شود).
#   • برای فعال شدن ثبت فرم‌ها در جدول inquiries و جست‌وجوی دیتابیسی،
#     یک PostgreSQL قابل‌دسترس بدهید.
# DATABASE_URL=postgresql://user:password@localhost:5432/freewheel

# ── نشانی عمومی سایت ──────────────────────────────────────────────
# در sitemap، robots، canonical و Open Graph استفاده می‌شود؛
# موقع استقرار روی دامین واقعی، حتماً ست کنید.
# NEXT_PUBLIC_SITE_URL=https://freewheel.ir

# ── اطلاعات تماس (نمایش در صفحه‌ی «تماس» و «درباره») ──────────────
# اگر خالی بمانند، جای‌نگهدارهای [شماره تماس] و ... نمایش داده می‌شوند.
# NEXT_PUBLIC_CONTACT_PHONE=021-00000000
# NEXT_PUBLIC_CONTACT_MOBILE=09120000000
# NEXT_PUBLIC_CONTACT_EMAIL=info@freewheel.ir
# NEXT_PUBLIC_CONTACT_ADDRESS=تهران، ...
